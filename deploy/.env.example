# Docker image to be used
# Local image
# LOCAP2P_IMAGE=locap2p-services:local
# Remote image
# LOCAP2P_IMAGE=ghcr.io/<owner>/<repo>:<ref>

# UID/GID used by the service containers
# Local deployment
# LOCAP2P_UID= 1000
# LOCAP2P_GID= 100
# Remote deployment
# LOCAP2P_UID= 1000
# LOCAP2P_GID= 1000

RUST_LOG=info

# DigitalOcean
DIGITALOCEAN_ACCESS_TOKEN=
DO_SSH_KEY=
DO_REGION=lon1
DO_SIZE=s-1vcpu-1gb
DROPLET_NAME=
